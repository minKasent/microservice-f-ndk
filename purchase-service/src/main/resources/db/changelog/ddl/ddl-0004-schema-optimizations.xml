<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="purchase-0007-alter-content-id-to-bigint" author="dangkhoa">
    <modifyDataType tableName="purchase" columnName="content_id" newDataType="BIGINT UNSIGNED"/>
    <modifyDataType tableName="user_library" columnName="content_id" newDataType="BIGINT UNSIGNED"/>
  </changeSet>

  <changeSet id="purchase-0008-add-idx-saga-step-updated" author="dangkhoa">
    <preConditions onFail="MARK_RAN">
      <not>
        <indexExists tableName="purchase_saga" indexName="idx_purchase_saga_step_updated"/>
      </not>
    </preConditions>
    <createIndex tableName="purchase_saga" indexName="idx_purchase_saga_step_updated">
      <column name="current_step"/>
      <column name="updated_at"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
