      <column name="skill_name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="proficiency_level" type="TINYINT">
        <constraints nullable="false"/>
      </column>
      <column name="year_of_experience" type="TINYINT">
